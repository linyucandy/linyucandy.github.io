<% const work = site.data.works.find(item => item.id === page.work_id); %>
<section class="book-detail shell"><div class="book-aside"><img src="<%= work.cover %>" alt="小说《<%= work.title %>》封面" width="420" height="590"><p>YUANGUO / <%= work.genre %></p></div><div class="book-description"><a class="breadcrumb" href="/works/">← 返回作品书架</a><p class="eyebrow"><%= work.eyebrow || 'A NOVEL BY YUANGUO' %></p><h1><%= work.title %></h1><p class="book-byline">yuanguo 著</p><p class="book-lead"><%= work.subtitle %></p><p><%= work.description %></p><% if (work.introduction) { %><p><%= work.introduction %></p><% } %><div class="tags"><% work.tags.forEach(tag => { %><span><%= tag %></span><% }); %></div><div class="actions"><a class="button primary" href="#story">了解故事 ↓</a><a class="text-link" href="/works/">返回书架 →</a></div><p class="fine-print"><%= work.notice || '本站当前提供作品介绍，暂未开放试读。' %></p></div></section>
<article class="article-shell work-story"><div class="prose"><%- page.content %></div></article>
