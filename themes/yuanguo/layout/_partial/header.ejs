<% const en = page.lang === 'en'; %>
<header class="site-header shell">
  <a class="wordmark" href="/" aria-label="<%= en ? 'yuanguo home' : 'yuanguo 首页' %>">yuanguo<span class="brand-dot">.</span></a>
  <nav class="main-nav" aria-label="<%= en ? 'Main navigation' : '主导航' %>">
    <% const nav = en ? [['/', 'Home'], ['/works/', 'Works'], ['/archives/', 'Notes'], ['/resume/en/', 'Resume'], ['/about/', 'About']] : [['/', '首页'], ['/works/', '作品'], ['/archives/', '手记'], ['/resume/', '简历'], ['/about/', '关于']]; %>
    <% nav.forEach(([href, label]) => { const active = href === '/' ? is_home() : ('/' + page.path).startsWith(href); %>
    <a href="<%= href %>"<%- active ? ' aria-current="page"' : '' %>><%= label %></a>
    <% }); %>
  </nav>
  <button class="theme-toggle" data-theme-toggle type="button" aria-label="<%= en ? 'Switch to dark theme' : '切换为深色主题' %>" title="<%= en ? 'Change theme' : '切换阅读主题' %>" hidden><span aria-hidden="true">◐</span></button>
</header>
