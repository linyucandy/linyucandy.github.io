<% const en = page.lang === 'en'; %>
<section class="resume-hero shell" aria-labelledby="resume-name">
  <div class="resume-heading">
    <p class="eyebrow"><%= en ? 'PROFESSIONAL PROFILE / RESUME' : 'PROFESSIONAL PROFILE / 求职简历' %></p>
    <h1 id="resume-name">yuanguo<span class="title-dot">.</span></h1>
    <p class="resume-role"><%= en ? 'Embedded & IoT Systems Development' : '嵌入式与物联网系统研发' %></p>
    <p class="resume-intro"><%= en ? 'Terminal firmware · Base stations / Gateways · Wireless protocols · Drivers' : '终端固件 · 基站/网关 · 无线协议 · 驱动开发' %><br><%= en ? 'Experience in MCU / RTOS, embedded Linux, and software team management.' : '具备 MCU / RTOS、嵌入式 Linux 与软件团队管理经历。' %></p>
    <div class="resume-focus" aria-label="<%= en ? 'Specializations' : '专业方向' %>"><span>UWB / EPD</span><span>MCU / RTOS</span><span>Linux / BMC</span><span>C / C++</span></div>
  </div>
  <div class="resume-actions"><a class="text-link" href="<%= en ? '/resume/' : '/resume/en/' %>" hreflang="<%= en ? 'zh-CN' : 'en' %>" lang="<%= en ? 'zh-CN' : 'en' %>"><%= en ? '中文简历' : 'English resume' %> ↗</a><button class="button primary" type="button" data-print-resume hidden><%= en ? 'Print / Save PDF' : '打印 / 保存 PDF' %> <span aria-hidden="true">↗</span></button><a class="text-link" href="https://github.com/linyucandy" target="_blank" rel="noopener noreferrer"><%= en ? 'GitHub profile' : 'GitHub 主页' %> ↗</a><p><%= en ? 'Updated · October 2026' : '履历更新 · 2026.10' %></p></div>
</section>
<div class="resume-layout shell">
  <aside class="resume-sidebar"><nav aria-label="<%= en ? 'Resume sections' : '简历目录' %>"><p class="eyebrow">ON THIS PAGE</p>
    <% const sections = [['overview', '专业概览', 'Summary'], ['skills', '专业技能', 'Technical Skills'], ['experience', '工作经历', 'Experience'], ['projects', '代表项目', 'Projects'], ['education', '教育背景', 'Education'], ['links', '公开链接', 'Public Links']]; %>
    <% sections.forEach(([id, zh, english], index) => { %><a href="#<%= id %>"><%= en ? english : zh %> <span><%= String(index + 1).padStart(2, '0') %></span></a><% }); %>
  </nav><p class="resume-aside-note"><%= en ? 'Explore my writing, too.' : '想认识文字里的另一面？' %><br><a href="/works/"><%= en ? 'Browse my works (Chinese)' : '浏览我的作品' %> →</a></p></aside>
  <article class="resume-content" aria-label="<%= en ? 'yuanguo embedded software resume' : 'yuanguo 软件研发简历' %>"><%- page.content %></article>
</div>
