<section class="page-heading shell"><p class="eyebrow">BETWEEN THE LINES</p><h1>创作手记<span class="title-dot">.</span></h1><p>在故事的页边，读到更多。</p></section>
<section class="archive-list shell" aria-label="手记列表"><% page.posts.sort('date', -1).each(post => { %><article class="archive-row"><time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY.MM.DD') %></time><div><p class="eyebrow"><%= post.note_type || '创作手记' %></p><h2><a href="<%= url_for(post.path) %>"><%= post.title %></a></h2><p><%= post.description %></p></div><a class="circle-link" href="<%= url_for(post.path) %>" aria-label="阅读：<%= post.title %>">↗</a></article><% }); %><nav class="pagination" aria-label="分页"><%- paginator({prev_text: '← 上一页', next_text: '下一页 →'}) %></nav></section>
